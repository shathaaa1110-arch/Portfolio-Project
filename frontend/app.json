{
  "expo": {
    "name": "thouq",
    "slug": "thouq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/branding/haila-icon.png",
    "scheme": "thouq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/branding/haila-icon.png",
      "infoPlist": {
        "ExpoLocalization_supportsRTL": true,
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF3DA",
        "foregroundImage": "./assets/images/branding/haila-adaptive-foreground.png",
        "monochromeImage": "./assets/images/branding/haila-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/branding/haila-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF3DA",
          "image": "./assets/images/branding/haila-adaptive-foreground.png",
          "imageWidth": 200
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم ذوق موقعك لاقتراح المطاعم القريبة ضمن المسافة التي تختارها."
        }
      ]
    ],
    "extra": {
      "supportsRTL": true,
      "forcesRTL": true
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
