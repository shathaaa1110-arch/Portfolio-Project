# Use the shared API server.
EXPO_PUBLIC_API_URL=https://thouq-api.onrender.com/api/v1

# Send real requests.
EXPO_PUBLIC_USE_MOCK=false

# Name/cuisine search is verified. Set false only for an older API deployment.
EXPO_PUBLIC_RESTAURANT_SEARCH_ENABLED=true

# Required by the current API after migration 0012 / PR #170.
# Use false only with an explicitly selected legacy single-round server.
EXPO_PUBLIC_SESSION_ROUNDS_ENABLED=true
