# Use the shared API server.
EXPO_PUBLIC_API_URL=https://thouq-api.onrender.com/api/v1

# Send real requests.
EXPO_PUBLIC_USE_MOCK=false

# Name/cuisine search is verified. Set false only for an older API deployment.
EXPO_PUBLIC_RESTAURANT_SEARCH_ENABLED=true

# Provisional FE-27 round contract. Keep false on the current single-round API.
# Mock mode supports the complete frontend flow without enabling production calls.
EXPO_PUBLIC_SESSION_ROUNDS_ENABLED=false
