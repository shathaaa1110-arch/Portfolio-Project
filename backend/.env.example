# Copy to backend/.env and replace placeholders. Never commit .env.
# URL-encode special characters in passwords.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://thouq_dev:CHANGE_ME@127.0.0.1:5432/thouq_dev
TEST_DATABASE_URL=postgresql+psycopg://thouq_test:CHANGE_ME@127.0.0.1:5432/thouq_test
CORS_ORIGINS=*
AUTHENTICA_API_KEY=
SMS_MODE=mock

# App notifications (BE-25): mock logs them, expo sends them through the Expo push service.
PUSH_MODE=mock
SECRET_KEY=
# Start of the shareable invite link, e.g. https://example.com/join; empty = share the code only.
INVITE_BASE_URL=
# Header with the caller's real address behind a proxy; empty locally.
CLIENT_IP_HEADER=
